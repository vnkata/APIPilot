?start: expr

?expr: func "(" arg ("," arg)* ")"
     | value

?arg: expr
    | list
    | value

list: "[" [arg ("," arg)*] "]"
value: QUOTED_STRING -> string
     | NUMBER        -> number
     | IDENTIFIER    -> variable

IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/
%import common.ESCAPED_STRING -> QUOTED_STRING
%import common.NUMBER
%import common.WS
%ignore WS