?start: expr

?expr: func_call
     | list
     | value

func_call: IDENTIFIER "(" [arg ("," arg)*] ")"

?arg: expr

list: "[" [arg ("," arg)*] "]"
value: QUOTED_STRING -> string
     | SINGLE_QUOTED_STRING -> string
     | NUMBER        -> number
     | IDENTIFIER    -> variable

IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_.\[\]]*/  // Cho phép dấu chấm và [] trong tên biến
%import common.ESCAPED_STRING -> QUOTED_STRING
%import common.SIGNED_NUMBER -> NUMBER
%import common.WS
%ignore WS

SINGLE_QUOTED_STRING: /'[^']*'/

