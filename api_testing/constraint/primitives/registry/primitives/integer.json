{
  "version": "1.0",
  "predicates": [
    {
      "kind": "int.range",
      "version": "v1",
      "category": "integer",
      "description": "Validate integer is within [min, max] range",
      "args_schema": {
        "type": "object",
        "properties": {
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "supported_types": [
        "integer"
      ],
      "examples": [
        {
          "args": {
            "min": 1,
            "max": 10
          },
          "valid": [
            1,
            5,
            10
          ],
          "invalid": [
            0,
            11
          ]
        }
      ],
      "implemented": true
    },
