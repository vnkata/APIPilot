  "version": "1.0",
  "predicates": [
    {
      "kind": "array.length",
      "version": "v1",
      "category": "array",
      "description": "Validate array length is within [min, max]",
      "args_schema": {
        "type": "object",
        "properties": {
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "supported_types": [
        "array"
      ],
      "examples": [
        {
          "args": {
            "min": 1,
            "max": 5
          },
          "valid": [
            [
              1,
              2
            ]
          ],
          "invalid": [
            [],
            [
              1,
              2,
              3,
              4,
              5,
              6
            ]
          ]
        }
      ],
      "implemented": false
    },
